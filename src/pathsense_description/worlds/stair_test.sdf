<?xml version="1.0"?>
<!-- Test world: a room with a 5-step staircase (150 mm rise, 300 mm tread) and a landing -->
<sdf version="1.9">
  <world name="stair_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"               name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system"      name="gz::sim::systems::AirPressure"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.88 0.92 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- floor -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.75 0.74 0.72 1</ambient><diffuse>0.75 0.74 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- staircase: 5 steps along +X starting at x = 2.5 m, 1.2 m wide -->
    <model name="staircase">
      <static>true</static>
      <pose>2.5 0 0 0 0 0</pose>
      <link name="link">
        <!-- each step is a solid block from the floor up to its tread height -->
        <collision name="s1"><pose>0.15 0 0.075 0 0 0</pose><geometry><box><size>0.30 1.2 0.15</size></box></geometry></collision>
        <collision name="s2"><pose>0.45 0 0.150 0 0 0</pose><geometry><box><size>0.30 1.2 0.30</size></box></geometry></collision>
        <collision name="s3"><pose>0.75 0 0.225 0 0 0</pose><geometry><box><size>0.30 1.2 0.45</size></box></geometry></collision>
        <collision name="s4"><pose>1.05 0 0.300 0 0 0</pose><geometry><box><size>0.30 1.2 0.60</size></box></geometry></collision>
        <collision name="s5"><pose>1.35 0 0.375 0 0 0</pose><geometry><box><size>0.30 1.2 0.75</size></box></geometry></collision>
        <collision name="landing"><pose>2.25 0 0.375 0 0 0</pose><geometry><box><size>1.5 1.2 0.75</size></box></geometry></collision>
        <visual name="s1"><pose>0.15 0 0.075 0 0 0</pose><geometry><box><size>0.30 1.2 0.15</size></box></geometry><material><ambient>0.62 0.60 0.56 1</ambient><diffuse>0.62 0.60 0.56 1</diffuse></material></visual>
        <visual name="s2"><pose>0.45 0 0.150 0 0 0</pose><geometry><box><size>0.30 1.2 0.30</size></box></geometry><material><ambient>0.66 0.64 0.60 1</ambient><diffuse>0.66 0.64 0.60 1</diffuse></material></visual>
        <visual name="s3"><pose>0.75 0 0.225 0 0 0</pose><geometry><box><size>0.30 1.2 0.45</size></box></geometry><material><ambient>0.62 0.60 0.56 1</ambient><diffuse>0.62 0.60 0.56 1</diffuse></material></visual>
        <visual name="s4"><pose>1.05 0 0.300 0 0 0</pose><geometry><box><size>0.30 1.2 0.60</size></box></geometry><material><ambient>0.66 0.64 0.60 1</ambient><diffuse>0.66 0.64 0.60 1</diffuse></material></visual>
        <visual name="s5"><pose>1.35 0 0.375 0 0 0</pose><geometry><box><size>0.30 1.2 0.75</size></box></geometry><material><ambient>0.62 0.60 0.56 1</ambient><diffuse>0.62 0.60 0.56 1</diffuse></material></visual>
        <visual name="landing"><pose>2.25 0 0.375 0 0 0</pose><geometry><box><size>1.5 1.2 0.75</size></box></geometry><material><ambient>0.66 0.64 0.60 1</ambient><diffuse>0.66 0.64 0.60 1</diffuse></material></visual>
      </link>
    </model>

    <!-- room walls (give the LiDAR something to map) -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north"><pose>1.5 3.0 0.6 0 0 0</pose><geometry><box><size>9 0.1 1.2</size></box></geometry></collision>
        <collision name="south"><pose>1.5 -3.0 0.6 0 0 0</pose><geometry><box><size>9 0.1 1.2</size></box></geometry></collision>
        <collision name="west"><pose>-3.0 0 0.6 0 0 0</pose><geometry><box><size>0.1 6 1.2</size></box></geometry></collision>
        <collision name="east"><pose>6.0 0 0.6 0 0 0</pose><geometry><box><size>0.1 6 1.2</size></box></geometry></collision>
        <visual name="north"><pose>1.5 3.0 0.6 0 0 0</pose><geometry><box><size>9 0.1 1.2</size></box></geometry><material><ambient>0.93 0.93 0.91 1</ambient><diffuse>0.93 0.93 0.91 1</diffuse></material></visual>
        <visual name="south"><pose>1.5 -3.0 0.6 0 0 0</pose><geometry><box><size>9 0.1 1.2</size></box></geometry><material><ambient>0.93 0.93 0.91 1</ambient><diffuse>0.93 0.93 0.91 1</diffuse></material></visual>
        <visual name="west"><pose>-3.0 0 0.6 0 0 0</pose><geometry><box><size>0.1 6 1.2</size></box></geometry><material><ambient>0.93 0.93 0.91 1</ambient><diffuse>0.93 0.93 0.91 1</diffuse></material></visual>
        <visual name="east"><pose>6.0 0 0.6 0 0 0</pose><geometry><box><size>0.1 6 1.2</size></box></geometry><material><ambient>0.93 0.93 0.91 1</ambient><diffuse>0.93 0.93 0.91 1</diffuse></material></visual>
      </link>
    </model>

    <!-- a few obstacles -->
    <model name="box_1">
      <static>true</static>
      <pose>0.5 1.8 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry><material><ambient>0.35 0.55 0.75 1</ambient><diffuse>0.35 0.55 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_1">
      <static>true</static>
      <pose>-1.2 -1.6 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>1.2</length></cylinder></geometry><material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
