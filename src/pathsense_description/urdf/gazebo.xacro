<?xml version="1.0"?>
<!-- Gazebo Harmonic (gz-sim 8) plugins, sensors and contact properties -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wheel_contact" params="link">
    <gazebo reference="${link}">
      <mu1>1.2</mu1>
      <mu2>0.7</mu2>          <!-- lower sideways grip so skid-steer turning works -->
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="tof_sensor" params="name">
    <gazebo reference="tof_${name}_link">
      <sensor name="tof_${name}" type="gpu_lidar">
        <gz_frame_id>tof_${name}_link</gz_frame_id>
        <topic>/tof/${name}</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.04</min><max>4.0</max><resolution>0.001</resolution></range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="pathsense_gazebo" params="use_tof arm_start">

    <!-- ===== contact / friction ===== -->
    <xacro:wheel_contact link="wheel_front_left_link"/>
    <xacro:wheel_contact link="wheel_rear_left_link"/>
    <xacro:wheel_contact link="wheel_front_right_link"/>
    <xacro:wheel_contact link="wheel_rear_right_link"/>
    <xacro:wheel_contact link="support_front_left_link"/>
    <xacro:wheel_contact link="support_rear_left_link"/>
    <xacro:wheel_contact link="support_front_right_link"/>
    <xacro:wheel_contact link="support_rear_right_link"/>
    <gazebo reference="arm_left_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>100.0</kd><minDepth>0.001</minDepth></gazebo>
    <gazebo reference="arm_right_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>100.0</kd><minDepth>0.001</minDepth></gazebo>
    <gazebo reference="base_link"><mu1>0.3</mu1><mu2>0.3</mu2></gazebo>

    <gazebo>
      <!-- ===== skid-steer track drive: /cmd_vel (geometry_msgs/Twist) ===== -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>wheel_front_left_joint</left_joint>
        <left_joint>support_front_left_joint</left_joint>
        <left_joint>support_rear_left_joint</left_joint>
        <left_joint>wheel_rear_left_joint</left_joint>
        <right_joint>wheel_front_right_joint</right_joint>
        <right_joint>support_front_right_joint</right_joint>
        <right_joint>support_rear_right_joint</right_joint>
        <right_joint>wheel_rear_right_joint</right_joint>
        <wheel_separation>${2*track_y}</wheel_separation>
        <wheel_radius>${track_r}</wheel_radius>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <min_linear_acceleration>-1.0</min_linear_acceleration>
        <max_angular_acceleration>3.0</max_angular_acceleration>
        <min_angular_acceleration>-3.0</min_angular_acceleration>
        <max_linear_velocity>1.0</max_linear_velocity>
        <min_linear_velocity>-1.0</min_linear_velocity>
        <max_angular_velocity>2.0</max_angular_velocity>
        <min_angular_velocity>-2.0</min_angular_velocity>
        <topic>/cmd_vel</topic>
        <odom_topic>/wheel_odom</odom_topic>
        <tf_topic>/wheel_tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
            <!-- ===== exact odometry from Gazebo (simulation only) ===== -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>

      <!-- ===== joint states for RViz / robot_state_publisher ===== -->
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
      </plugin>

      <!-- ===== climbing arm position control: /arm_left/cmd_pos, /arm_right/cmd_pos (std_msgs/Float64, rad) ===== -->
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>arm_left_joint</joint_name>
        <topic>/arm_left/cmd_pos</topic>
        <initial_position>${arm_start}</initial_position>
        <p_gain>60</p_gain>
        <i_gain>2</i_gain>
        <d_gain>4</d_gain>
        <i_max>10</i_max>
        <i_min>-10</i_min>
        <cmd_max>25</cmd_max>
        <cmd_min>-25</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>arm_right_joint</joint_name>
        <topic>/arm_right/cmd_pos</topic>
        <initial_position>${arm_start}</initial_position>
        <p_gain>60</p_gain>
        <i_gain>2</i_gain>
        <d_gain>4</d_gain>
        <i_max>10</i_max>
        <i_min>-10</i_min>
        <cmd_max>25</cmd_max>
        <cmd_min>-25</cmd_min>
      </plugin>
    </gazebo>

    <!-- ===== 2D LiDAR (RPLIDAR A1: 360 deg, 12 m) ===== -->
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>lidar_link</gz_frame_id>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </gazebo>

    <!-- ===== forward camera (real: 1080p wide angle; sim at 640x360 to stay light) ===== -->
    <gazebo reference="camera_front_link">
      <sensor name="camera_front" type="camera">
        <gz_frame_id>camera_front_optical_frame</gz_frame_id>
        <topic>/camera/front/image_raw</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.92</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30.0</far></clip>
        </camera>
      </sensor>
    </gazebo>

    <!-- ===== stair camera (tilted down) ===== -->
    <gazebo reference="camera_stair_link">
      <sensor name="camera_stair" type="camera">
        <gz_frame_id>camera_stair_optical_frame</gz_frame_id>
        <topic>/camera/stair/image_raw</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.92</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image>
          <clip><near>0.03</near><far>10.0</far></clip>
        </camera>
      </sensor>
    </gazebo>

    <!-- ===== IMU (BNO055) ===== -->
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <topic>/imu</topic>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <!-- ===== barometer (BMP390): detects change of floor ===== -->
    <gazebo reference="pressure_link">
      <sensor name="air_pressure" type="air_pressure">
        <gz_frame_id>pressure_link</gz_frame_id>
        <topic>/air_pressure</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <air_pressure>
          <reference_altitude>560</reference_altitude>  <!-- Pune, approx. metres above sea level -->
          <pressure><noise type="gaussian"><mean>0</mean><stddev>0.5</stddev></noise></pressure>
        </air_pressure>
      </sensor>
    </gazebo>

    <!-- ===== time-of-flight edge sensors ===== -->
    <xacro:if value="${use_tof}">
      <xacro:tof_sensor name="front_left"/>
      <xacro:tof_sensor name="front_right"/>
      <xacro:tof_sensor name="rear_left"/>
      <xacro:tof_sensor name="rear_right"/>
      <xacro:tof_sensor name="side_left"/>
      <xacro:tof_sensor name="side_right"/>
    </xacro:if>

  </xacro:macro>
</robot>
